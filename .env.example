# GEMINI_API_KEY: Required by AI Studio runtime if AI features are enabled.
GEMINI_API_KEY=

# APP_URL: Public URL of the deployed application (used for invite links).
APP_URL=http://localhost:3000

# SUPABASE (Optional for local dev, required for shared multi-instance persistence in production)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LIVEKIT (Optional voice chat integration; disabled gracefully if omitted)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
